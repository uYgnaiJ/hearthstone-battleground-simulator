{
  "name": "bobs-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Battlegrounds workshop with local opponents, editable cards and a combat debugger",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "node tools/native.mjs build",
    "start": "node tools/native.mjs start",
    "test": "node tools/native.mjs test",
    "soak": "node tools/native.mjs soak",
    "import:cards": "node tools/import-cards.mjs",
    "package": "npm run build",
    "test:native": "node tools/native.mjs smoke",
    "setup:native": "node tools/native.mjs setup"
  },
  "devDependencies": {
    "hearthstone-card-images": "^5.0.2"
  }
}
