{
  "name": "bobs-workshop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Battlegrounds workshop with local opponents, editable cards and a combat debugger",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run.ps1",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test.ps1",
    "soak": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test.ps1 -SkipBuild -Soak",
    "import:cards": "node tools/import-cards.mjs",
    "package": "npm run build",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/test.ps1 -Smoke",
    "setup:native": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup.ps1"
  },
  "devDependencies": {
    "hearthstone-card-images": "^5.0.2"
  }
}
